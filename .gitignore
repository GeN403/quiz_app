# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ただし、.env.example はサンプルファイルなのでコミットする
!.env.example
!**/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Next.js build output
frontend/.next/

# Node modules
frontend/node_modules/

# --- Python / Backend ---

# Pythonキャッシュ (プロジェクト全体)
**/__pycache__/

# バックエンドの環境変数
backend/.env

# 仮想環境 (Virtual Environments)
/venv/
/.venv/
/backend/venv/
backend/venv/
# FAISS（ベクトルストア）のインデックス
# (data/ から自動生成されるためリポジトリに含めない)
backend/project/faiss_index/

# ダウンロードされる埋め込みモデル
# (HuggingFaceEmbeddingsなどが自動ダウンロードするキャッシュ)
backend/project/models/

/.claude/
/backend/project/
.kiro
.codex

# RAG実験・ノートブック
backend/notebooks/
backend/project/

# 使い捨てスクリプト
backend/scripts/
scripts/

# バックアップ・一時ファイル
*.backup
*.old
*.bak
*.tmp

# pytest キャッシュ
.pytest_cache/
**/.pytest_cache/

# BFG Repo-Cleaner レポート
*.git.bfg-report/

# Local SQLite database
backend/quiz_app.db
